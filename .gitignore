# ---------------------------------------------------------------------------
# Voting System — ignore rules
# Governed by: docs/process/policies/configuration-management.md §4
# ---------------------------------------------------------------------------

# --- Secrets: never versioned (Security & Secrets Policy §2.1) ---
includes/config.php
.env
.env.*
*.pem
*.key

# --- Runtime data: never versioned (CM Policy §4) ---
*.db
*.db-*
*.db.*
*.sqlite
*.sqlite3

# --- Dependencies: reproducible via Composer ---
/vendor/

# --- User-uploaded media: never commit real people's photos ---
# Uploads land in images/ named <timestamp>_<kind>_<uniqid>.<ext>.
# These are PERSONAL DATA. Party logos (images/*_party_*) are app assets
# and stay tracked; only per-person uploads are excluded.
images/*_voter_*
images/*_photo_*
images/*_doc_*
images/*_candidate_*
images/face_audit/
# Booth-captured face reference photos (voters.face_photo)
images/reference_*

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Build / test output ---
/coverage/
*.log

voting_system.db
voting_system.db*
*.db
